@model MenuItem
@{ ViewData["Title"] = "Edit menu item"; }
<div class="page-heading"><p class="eyebrow">MENU MANAGEMENT</p><h1>Edit menu item</h1><p>Update the details or correct the stock quantity.</p></div>
<div class="form-card">
<form asp-action="Edit" method="post">
  <input type="hidden" asp-for="Id" /><div asp-validation-summary="ModelOnly" class="validation-summary"></div>
  <div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="field-error"></span></div>
  <div class="mb-3"><label asp-for="Category" class="form-label"></label><input asp-for="Category" class="form-control" /><span asp-validation-for="Category" class="field-error"></span></div>
  <div class="row g-3"><div class="col-sm-6 mb-3"><label asp-for="Price" class="form-label"></label><div class="input-group"><span class="input-group-text">₹</span><input asp-for="Price" class="form-control" type="number" min="0.01" step="0.01" /></div><span asp-validation-for="Price" class="field-error"></span></div><div class="col-sm-6 mb-3"><label asp-for="AvailableQuantity" class="form-label"></label><input asp-for="AvailableQuantity" class="form-control" type="number" min="0" /></div></div>
  <div class="form-actions"><a class="btn btn-light" asp-action="Index">Cancel</a><button class="btn btn-cafe" type="submit">Save changes</button></div>
</form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

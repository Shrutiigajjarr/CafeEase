@model IEnumerable<Bill>
@{ ViewData["Title"] = "Billing"; }
<div class="page-heading d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3"><div><p class="eyebrow">CHECKOUT & HISTORY</p><h1>Billing</h1><p>Review previous bills or create a new checkout.</p></div><a class="btn btn-cafe" asp-action="Create">＋ Create a bill</a></div>
<div class="table-card">
@if (!Model.Any()) { <div class="empty-state"><div class="empty-icon">₹</div><h3>No bills recorded</h3><p>Your completed checkouts will be listed here.</p><a class="btn btn-cafe" asp-action="Create">Create first bill</a></div> }
else { <div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Bill number</th><th>Customer</th><th>Date & time</th><th class="text-end">Total amount</th><th></th></tr></thead><tbody>@foreach (var bill in Model) { <tr><td class="fw-semibold">#@bill.Id.ToString("D4")</td><td>@bill.CustomerName</td><td>@bill.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</td><td class="text-end fw-semibold">₹@bill.TotalAmount.ToString("N2")</td><td class="text-end"><a class="table-action" asp-action="Details" asp-route-id="@bill.Id">Receipt →</a></td></tr> }</tbody></table></div> }
</div>

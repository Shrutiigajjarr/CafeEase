@model Bill
@{ ViewData["Title"] = $"Bill #{Model.Id:D4}"; }
<div class="page-heading d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3"><div><p class="eyebrow">PAYMENT RECORD</p><h1>Receipt <span class="muted-heading">#@Model.Id.ToString("D4")</span></h1><p>Created @Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</p></div><div class="d-flex gap-2"><button class="btn btn-outline-cafe" onclick="window.print()">Print receipt</button><a class="btn btn-cafe" asp-action="Create">New bill</a></div></div>
<div class="receipt-card"><div class="receipt-brand"><span class="brand-mark">C</span><div><strong>CafeEase</strong><span>Thank you for your order</span></div><span class="receipt-paid">COMPLETED</span></div><div class="receipt-meta"><div><span>Customer</span><strong>@Model.CustomerName</strong></div><div><span>Bill number</span><strong>#@Model.Id.ToString("D4")</strong></div><div><span>Date</span><strong>@Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</strong></div></div>
<div class="table-responsive"><table class="table align-middle"><thead><tr><th>Item</th><th class="text-end">Price</th><th class="text-end">Qty</th><th class="text-end">Amount</th></tr></thead><tbody>@foreach (var item in Model.Items) { <tr><td>@item.ItemName</td><td class="text-end">₹@item.UnitPrice.ToString("N2")</td><td class="text-end">@item.Quantity</td><td class="text-end fw-semibold">₹@item.LineTotal.ToString("N2")</td></tr> }</tbody></table></div><div class="receipt-total"><span>Total amount</span><strong>₹@Model.TotalAmount.ToString("N2")</strong></div><p class="receipt-thanks">Made with care. Come back soon!</p></div>

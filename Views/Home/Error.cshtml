@model ErrorViewModel
@{ ViewData["Title"] = "Error"; }
<div class="empty-state"><div class="empty-icon">!</div><h1>Something went wrong</h1><p>We couldn't complete that request. Please try again.</p>@if (Model.ShowRequestId) { <p class="text-muted small">Reference: @Model.RequestId</p> }<a class="btn btn-cafe" asp-controller="Home" asp-action="Index">Back to dashboard</a></div>
